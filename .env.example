# PostgreSQL
POSTGRES_DB=smart_city_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/smart_city_db

# URL-uri microservicii (pe host; în Docker compose le înlocuiește cu numele containerelor)
ACO_SERVICE_URL=http://localhost:8000
VERIFICATION_SERVICE_URL=http://localhost:8090

# Auth
CORS_ORIGINS_RAW=*
JWT_SECRET_KEY=dev-only-change-me-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Sync catalog Cluj din Overpass la pornirea backend-ului
SYNC_ATTRACTIONS_ON_STARTUP=true

# Utilizatori creați automat la primul start
SEED_ADMIN_USER=true
ADMIN_USER_EMAIL=admin@admin.com
ADMIN_USER_PASSWORD=admin123
ADMIN_USER_FIRST_NAME=Admin
ADMIN_USER_LAST_NAME=User

# Verificare identitate
VERIFICATION_UPLOAD_DIR=uploads/verification
VERIFICATION_APPROVE_THRESHOLD=0.55

# OSRM — fișierul .pbf din osrm-service/data/source/
OSM_FILE=romania-260322.osm.pbf
OSM_DATASET=romania-260322
HTTP_OSRM_TIMEOUT_SECONDS=25
