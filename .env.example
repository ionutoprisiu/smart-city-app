# PostgreSQL
POSTGRES_DB=smart_city_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/smart_city_db

# Microservice URLs (host-side defaults; docker-compose overrides with service names)
ACO_SERVICE_URL=http://localhost:8000
VERIFICATION_SERVICE_URL=http://localhost:8090
CHAT_SERVICE_URL=http://localhost:8002

# CORS / Auth
CORS_ORIGINS_RAW=*
JWT_SECRET_KEY=dev-only-change-me-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Visit City catalog: full Cluj sync from Overpass when backend starts
SYNC_ATTRACTIONS_ON_STARTUP=true

# Seed users
SEED_DEMO_USER=false
SEED_ADMIN_USER=true
ADMIN_USER_EMAIL=admin@admin.com
ADMIN_USER_PASSWORD=admin

# OSRM
HTTP_OSRM_TIMEOUT_SECONDS=25
OSM_FILE=romania-260322.osm.pbf
OSM_DATASET=romania-260322

# Verification thresholds
VERIFICATION_APPROVE_THRESHOLD=0.55

# LLM (Ollama on host) used by chat-service for organizer auto-reply
LLM_MODEL=qwen2.5:7b-instruct
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
