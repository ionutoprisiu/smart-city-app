# Copy this file to .env before running docker compose.

# PostgreSQL
POSTGRES_DB=licenta_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# OSRM — place the .osm.pbf in ./osrm-data/source/
OSM_FILE=cluj.osm.pbf
OSM_DATASET=cluj.osm

# Verification service
VERIFICATION_APPROVE_THRESHOLD=0.62
VERIFICATION_MANUAL_THRESHOLD=0.50
