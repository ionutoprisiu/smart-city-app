# --- OSRM ---
# Use mode-specific URLs so each profile hits a graph built with the matching Lua profile (foot.lua, car.lua).
OSRM_BASE_URL=https://router.project-osrm.org
# OSRM_FOOT_BASE_URL=http://127.0.0.1:5000
# OSRM_DRIVING_BASE_URL=http://127.0.0.1:5001
# Timeout (seconds) for each OSRM HTTP call (`/table`, `/route`).
HTTP_OSRM_TIMEOUT_SECONDS=25

# --- Fallback travel-time (when OSRM durations are unavailable) ---
WALKING_SPEED_KMH=4.0
DRIVING_SPEED_KMH=28.0

# --- HTTP API ---
# Comma-separated origins, or "*" for allow-all (dev only).
CORS_ORIGINS_RAW=*
