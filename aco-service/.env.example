# OSRM endpoints. Use mode-specific URLs to point each profile at a graph
# preprocessed with the matching Lua profile (foot.lua, car.lua).
OSRM_BASE_URL=https://router.project-osrm.org
# OSRM_FOOT_BASE_URL=http://127.0.0.1:5000
# OSRM_DRIVING_BASE_URL=http://127.0.0.1:5001

# Fallback travel-time speeds (km/h) used when OSRM durations are unavailable.
WALKING_SPEED_KMH=4.0
DRIVING_SPEED_KMH=28.0

# CORS — comma-separated origins or "*".
CORS_ORIGINS_RAW=*
